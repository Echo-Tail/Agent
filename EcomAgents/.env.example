# Required production configuration
DB_URL=jdbc:postgresql://localhost:5432/ecomagents
DB_USERNAME=ecomagents
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# Generate with: openssl rand -base64 32
MODEL_CREDENTIAL_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
CORS_ALLOWED_ORIGINS=https://app.example.com

# Persistent storage
FILE_UPLOAD_DIR=/var/lib/ecomagents/uploads

# Image runtime worker
IMAGE_RUNTIME_WORKER_ENABLED=true
IMAGE_RUNTIME_WORKER_CONCURRENCY=2
# Set a stable, unique value per instance; blank uses a generated id.
IMAGE_RUNTIME_WORKER_ID=
IMAGE_RUNTIME_LEASE_SECONDS=60
IMAGE_RUNTIME_POLL_INTERVAL_MS=1000
IMAGE_RUNTIME_HEARTBEAT_INTERVAL_MS=20000
IMAGE_RUNTIME_RECOVERY_INTERVAL_MS=30000
IMAGE_RUNTIME_MAX_ATTEMPTS=3
IMAGE_RUNTIME_RETRY_BASE_SECONDS=5
IMAGE_RUNTIME_PROVIDER_POLL_SECONDS=3
IMAGE_RUNTIME_BAILIAN_TIMEOUT_SECONDS=600
IMAGE_RUNTIME_OPENAI_TIMEOUT_SECONDS=300
IMAGE_RUNTIME_INPUT_CLEANUP_CRON="0 30 3 * * ?"
CHAT_IMAGE_WAIT_TIMEOUT_SECONDS=30

# Never enable the mock adapter in production.
IMAGE_RUNTIME_MOCK_ADAPTER_ENABLED=false
